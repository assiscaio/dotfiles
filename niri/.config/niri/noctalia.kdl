layout {

    focus-ring {
        active-color   "#babbf1"
        inactive-color "#303446"
        urgent-color   "#e78284"
    }

    border {
        active-color   "#babbf1"
        inactive-color "#303446"
        urgent-color   "#e78284"
    }


    tab-indicator {
        active-color   "#babbf1"
        inactive-color "#2427d5"
        urgent-color   "#e78284"
    }

    insert-hint {
        color "#babbf180"
    }
}

recent-windows {
    highlight {
        active-color "#babbf1"
        urgent-color "#e78284"
    }
}
